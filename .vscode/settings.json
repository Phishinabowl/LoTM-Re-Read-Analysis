{
    "todo-tree.general.tags": [
        "TODO",
        "FIXME",
        "QUESTION",
        "ASSUMPTION",
        "HACK",
        "REVIEW",
        "VERIFY"
    ],
    "todo-tree.regex.subTagRegex": "^(?=\\s*\\(([^)]+)\\))",
    "todo-tree.tree.groupedBySubTag": true,
    "todo-tree.tree.scanMode": "workspace",
    "mermaidChart.aiSkills.enabled": false,
    "todo-tree.filtering.passGlobsToRipgrep": true,
    "todo-tree.filtering.useBuiltInExcludes": "file and search excludes",
    "todo-tree.filtering.excludeGlobs": [
        "**/.git/**",
        "**/.local/**",
        "**/.obsidian/**",
        "**/.tmp/**",
        "**/.vscode/**",
        "**/Artwork/Source/**",
        "**/Boards/**",
        "**/Glossary_Threads/**",
        "**/Investigations/**",
        "**/Obsidian_Export/**",
        "**/Source/**",
        "**/Testing/**",
        "**/Tools/Static/Fixtures/Work-Annotations/**",
        "**/Volumes/**",
        "**/WORK_ANNOTATION_STANDARDS.md"
    ]
}
